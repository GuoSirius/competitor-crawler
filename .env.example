# ===== 数据库（无感切换：改这里即可，业务代码零改动）=====
# DB_DIALECT 可选：sqlite（默认/本地）| mysql | postgresql
# 切换步骤：改 DB_DIALECT + DATABASE_URL → pnpm --filter @competitor-crawler/shared db:push（按方言建表）→ 迁移历史数据 → 重启 crawl/web
DB_DIALECT=sqlite
# sqlite：本地文件路径（相对仓库根）；mysql/pg：连接串
DATABASE_URL=./data/crawler.sqlite
# mysql 示例：DATABASE_URL=mysql://user:pass@host:3306/competitor
# postgresql 示例：DATABASE_URL=postgres://user:pass@host:5432/competitor

# ===== 模型部署模式：local | cloud | hybrid（三选一，纯配置）=====
MODEL_MODE=hybrid

# 本地（Ollama / vLLM，OpenAI 兼容）
MODEL_LOCAL_BASE_URL=http://localhost:11434/v1
MODEL_LOCAL_API_KEY=ollama
MODEL_LOCAL_MODEL=qwen2.5:14b-instruct

# 云端兜底（通义 / DeepSeek / Claude，OpenAI 兼容）
MODEL_CLOUD_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_CLOUD_API_KEY=
MODEL_CLOUD_MODEL=qwen-max

# 通用
MODEL_TEMPERATURE=0
MODEL_MAX_RETRIES=1

# ⑦ 告警摘要（summary）：默认关闭，置 true 才调模型把告警翻成人话；关闭时零开销
MODEL_SUMMARY_ENABLED=false

# ===== 告警通道（调度器 summary 推送；零依赖，纯 webhook POST）=====
# 企微群机器人 webhook（群 → 添加机器人 → 复制 webhook 地址）
ALERT_WECOM_WEBHOOK=
# 钉钉群机器人 webhook
ALERT_DINGTALK_WEBHOOK=
# 邮件网关 webhook（可选；POST JSON 即发信，如 Server酱 / 自建邮件 API）
ALERT_EMAIL_WEBHOOK=

# ===== 抓取并发（docs/16 P5）=====
# 详情页并发抓取数（每个栏目内）。默认 4：太高易触发 WAF/被拉黑，太低整轮太慢
CRAWL_DETAIL_CONCURRENCY=4
