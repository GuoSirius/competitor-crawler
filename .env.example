# ===== 数据库（无感切换：改这里即可，业务代码零改动）=====
# DB_DIALECT 可选：sqlite（默认/本地）| mysql | postgresql
# 切换步骤：改 DB_DIALECT + DATABASE_URL → pnpm --filter @competitor-crawler/shared db:push（按方言建表）→ 迁移历史数据 → 重启 crawl/web
DB_DIALECT=sqlite
# sqlite：本地文件路径（相对仓库根）；mysql/pg：连接串
DATABASE_URL=./data/crawler.sqlite
# mysql 示例：DATABASE_URL=mysql://user:pass@host:3306/competitor
# postgresql 示例：DATABASE_URL=postgres://user:pass@host:5432/competitor

# ===== 模型部署模式：local | cloud | hybrid（三选一，纯配置）=====
MODEL_MODE=hybrid

# 本地（Ollama / vLLM，OpenAI 兼容）
MODEL_LOCAL_BASE_URL=http://localhost:11434/v1
MODEL_LOCAL_API_KEY=ollama
MODEL_LOCAL_MODEL=qwen2.5:14b-instruct

# 云端兜底（通义 / DeepSeek / Claude，OpenAI 兼容）
MODEL_CLOUD_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_CLOUD_API_KEY=
MODEL_CLOUD_MODEL=qwen-max

# 通用
MODEL_TEMPERATURE=0
MODEL_MAX_RETRIES=1

# ⑦ 告警摘要（summary）：默认关闭，置 true 才调模型把告警翻成人话；关闭时零开销
MODEL_SUMMARY_ENABLED=false

# ===== 告警通道（调度器 summary 推送；零依赖，纯 webhook POST）=====
# 企微群机器人 webhook（群 → 添加机器人 → 复制 webhook 地址）
ALERT_WECOM_WEBHOOK=
# 钉钉群机器人 webhook
ALERT_DINGTALK_WEBHOOK=
# 邮件网关 webhook（可选；POST JSON 即发信，如 Server酱 / 自建邮件 API）
ALERT_EMAIL_WEBHOOK=

# ===== 抓取并发（docs/16 P5）=====
# 详情页并发抓取数（每个栏目内）。0 或未设 = 按 CPU 核心数自适应；
# 合法正整数则直接使用。抓取是 IO 密集，嫌慢可显式调大，太高易触发 WAF/被拉黑
CRAWL_DETAIL_CONCURRENCY=0

# ===== 渲染 / 反爬（fetch/antiBot.ts，2026-10-01）=====
# 代理地址（**按需用**，默认直连）。填完整 URL，不是只填端口。
#   写法： http://127.0.0.1:7890   （scheme + 主机 + 端口，缺 scheme 会被 Playwright 拒）
#   端口 = 你 VPN 客户端（魔戒 / Clash / v2rayN …）的「本地 HTTP 监听端口」。各客户端默认值不同，
#         且同一客户端换机 / 换版本都可能变 → **别照抄别人的端口**，按下面方法查本机实际值。
#   常见默认值仅作参考（以本机为准）：Clash 系 7890/7897、v2rayN 10809、本机「魔戒」实听 17890。
#   ★ 怎么查本机实际端口（不依赖客户端 UI，最可靠）：
#     1) netstat -an | grep LISTENING        # 找有大量外部 ESTABLISHED 连接的 127.0.0.1 端口（代理特征）
#     2) curl -s -o /dev/null -w "%{http_code}" --noproxy '*' http://127.0.0.1:<端口>   # 返回 400 = 它就是 HTTP 代理
#     3) netstat -ano | grep <端口>           # 拿 PID → tasklist | grep <PID> 看进程名，确认是 clash / v2ray 等
# 怎么用：在需要走代理的站点 YAML 顶层写一行 `proxy: '${CRAWL_PROXY}'`，端口只在本行维护一处。
#   为什么需要它：Chromium **不认** http_proxy / HTTPS_PROXY 环境变量（只读 Windows 系统代理设置），
#   Node 的 fetch 也不认 → 开了 VPN 若不在 YAML 显式配，抓取仍以本机国内 IP 直连，
#   境外站 WAF 按「国内 IP + 自动化指纹」判爬虫。实测逸漠 XImo 同一页面：直连 403 → 走代理 200。
#   不配 proxy 的站一律直连（国内站不该被绕出国）。
CRAWL_PROXY=
# 无头开关：默认 false = 有头（本机桌面有头更隐蔽、过盾率高）；CI/无显示环境设 true
CRAWL_BROWSER_HEADLESS=false
# 浏览器渲染观察窗硬上限（毫秒）：快站 2~3s 即走，上限只兜底慢站；跨境/弱网站可调 60000
CRAWL_BROWSER_MAX_WAIT=30000
# networkidle 未触发时至少观察时长（毫秒）：埋点长轮询站靠它兜底
CRAWL_BROWSER_NETWORK_WAIT=18000
# Playwright goto 超时（毫秒）：跨境慢站 45s 不够时调大
CRAWL_GOTO_TIMEOUT=45000
# 人工过盾开关：遇到交互验证（reCAPTCHA/滑块）时有头窗口暂停等待人工完成（最长 180s），
# 通过后会话持久化到 .runtime/state/<host>.json，后续轮次自动复用免验证。CI/无人值守设 false
CRAWL_INTERACTIVE=true
# 调试开关：设 1 时 browserFetch 在 waitSelector 命中后打印页面状态，并把最终返回 HTML
# dump 到 .tmp/debug/browser-dump.html（排查接口渲染空壳问题用）；空/未设 = 关闭
CRAWL_DEBUG_DUMP=

# ===== 落库批次（docs/16 规模化兜底）=====
# 增量批量落库：每批最多 upsert 的产品条数（默认 200）。批内价格历史多行一次写入，
# MySQL/PG 方言整批包 1 个事务（仅 1 次 commit）。调大减少往返、调小降低单批内存
CRAWL_UPSERT_BATCH=200

# 挑战页自动放行重试轮数（CF 托管挑战默认 8 轮 × 6s）。
# 触发条件：assessChallenge 命中 Cloudflare 信号（响应头 cf-mitigated/cf-chl-* 或
# 「Just a moment…」文案）。每轮都是「留在挑战页等盾 JS 写 cf_clearance → 带 cookie 重新
# 导航原 URL → 重新判定」，不是原地干等；一旦放行立刻把会话持久化到 .runtime/state/<host>.json。
# 仍不过就进入人工过盾环节（有头 + CRAWL_INTERACTIVE=true），再不过按 IP 级拦截处理
CRAWL_CHALLENGE_ROUNDS=8
# 每轮间隔毫秒：CF 通常 3~8s 落 cookie；跨境/弱网站调大（如 10000）
CRAWL_CHALLENGE_WAIT_MS=6000

# ===== 方案A 启动器（pnpm plan:a，过 CF 托管挑战用，2026-10-07）=====
# 本机 Chrome 可执行文件完整路径（必填）。配一次系统环境变量即可，之后直接 `pnpm plan:a <domain>`。
#   查路径：开始菜单 Chrome → 右键「打开文件位置」→ 复制 chrome.exe 完整路径
#   注：推荐配成系统级环境变量（一次到位）；此处登记仅为满足 env 契约测试，空值不影响
CHROME_BIN=
# 别名（与上者二选一）：PLAN_A_CHROME 与 CHROME_BIN 等效
PLAN_A_CHROME=
# 过盾后是否把 cookie 持久化到 .runtime/state/<host>.json（供 crawl 复用）。
#   置 1 = 等价于 `pnpm plan:a <domain> --persist`；空/0 = 仅本次 diagnose 验证
PLAN_A_PERSIST=
# Chrome 远程调试端口（默认 9222）；必须与 `pnpm plan:a` 启动的 Chrome 一致
CDP_PORT=9222
# 方案A 启动 Chrome 时使用的用户数据目录（默认 .runtime/cdp-profile，隔离你的常驻 Chrome）。
#   想复用常驻 Chrome 的已登录会话可改成真实 profile 目录（需先关闭其它 Chrome 实例）
CHROME_USER_DATA_DIR=
