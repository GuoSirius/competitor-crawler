{
  "name": "competitor-crawler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "seed": "pnpm --filter @competitor-crawler/crawler seed",
    "crawl": "pnpm --filter @competitor-crawler/crawler crawl",
    "report": "pnpm --filter @competitor-crawler/crawler report",
    "db:push": "pnpm --filter @competitor-crawler/shared db:push",
    "probe": "pnpm --filter @competitor-crawler/crawler probe",
    "gen-site": "pnpm --filter @competitor-crawler/crawler gen-site",
    "backfill": "pnpm --filter @competitor-crawler/crawler backfill",
    "playwright:install": "pnpm --filter @competitor-crawler/crawler exec playwright install chromium",
    "dev:web": "pnpm --filter @competitor-crawler/web dev",
    "build:web": "pnpm --filter @competitor-crawler/web build",
    "typecheck": "node scripts/typecheck.mjs",
    "typecheck:web": "pnpm --filter @competitor-crawler/web typecheck",
    "typecheck:all": "node scripts/typecheck.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepare": "husky || true",
    "commitlint": "commitlint",
    "changelog": "standard-version --skip.commit --skip.tag",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "latest",
    "@commitlint/config-conventional": "latest",
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "@types/nodemailer": "latest",
    "eslint": "latest",
    "husky": "latest",
    "prettier": "latest",
    "standard-version": "latest",
    "tsx": "latest",
    "typescript": "^6.0.3",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
