{
  "name": "competitor-crawler",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "seed": "pnpm --filter @competitor-crawler/crawler exec tsx src/cli.ts seed",
    "crawl": "pnpm --filter @competitor-crawler/crawler exec tsx src/cli.ts crawl",
    "report": "pnpm --filter @competitor-crawler/crawler exec tsx src/cli.ts report",
    "db:push": "pnpm --filter @competitor-crawler/shared exec drizzle-kit push",
    "db:clear": "pnpm --filter @competitor-crawler/crawler exec tsx src/cli.ts db-clear",
    "db:clear:now": "pnpm --filter @competitor-crawler/crawler exec tsx src/cli.ts db-clear --yes",
    "probe": "pnpm --filter @competitor-crawler/crawler exec tsx src/cli.ts probe",
    "sweep": "pnpm --filter @competitor-crawler/crawler exec tsx src/cli.ts sweep",
    "diagnose": "pnpm --filter @competitor-crawler/crawler exec tsx src/cli.ts diagnose",
    "gen-site": "pnpm --filter @competitor-crawler/crawler exec tsx src/cli.ts gen-site",
    "gen-site:batch": "pnpm --filter @competitor-crawler/crawler exec tsx src/cli.ts gen-site-batch",
    "gen-site:template": "pnpm --filter @competitor-crawler/crawler exec tsx src/cli.ts gen-site-template",
    "backfill": "pnpm --filter @competitor-crawler/crawler exec tsx src/cli.ts backfill",
    "schedule": "pnpm --filter @competitor-crawler/crawler exec tsx src/cli.ts schedule",
    "playwright:install": "pnpm --filter @competitor-crawler/crawler exec playwright install chromium",
    "dev:web": "pnpm --filter @competitor-crawler/web dev",
    "build:web": "pnpm --filter @competitor-crawler/web build",
    "typecheck": "node scripts/typecheck.mjs",
    "typecheck:web": "pnpm --filter @competitor-crawler/web typecheck",
    "typecheck:all": "node scripts/typecheck.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepare": "husky || true",
    "commitlint": "commitlint",
    "changelog": "standard-version --skip.commit --skip.tag",
    "changelog:rebuild": "node scripts/changelog-rebuild.mjs",
    "release": "node scripts/release.mjs",
    "validate": "pnpm --filter @competitor-crawler/crawler exec tsx src/cli.ts validate",
    "field-docs": "pnpm --filter @competitor-crawler/crawler exec tsx src/cli.ts field-docs",
    "plan:a": "node scripts/plan-a/launch.mjs",
    "plan:b": "node scripts/plan-b/cookie-txt-to-state.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "latest",
    "@commitlint/config-conventional": "latest",
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "@types/nodemailer": "latest",
    "eslint": "latest",
    "husky": "latest",
    "prettier": "latest",
    "standard-version": "latest",
    "tsx": "latest",
    "typescript": "^6.0.3",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
